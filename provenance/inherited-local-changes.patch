+def prompt_selection_metric_redaction_enabled(cfg) -> bool:
+    """Return whether controller metrics must be absent from model prompts.
+
+    This is opt-in to preserve upstream inference behavior. It is required for
+    selector-isolation experiments where ``node.metric`` comes from a hidden
+    host evaluator: the controller may use that metric, but the code-generating
+    model must not receive its value or score-derived rankings as feedback.
+    """
+    experience_cfg = _config_get(cfg, "experience", {}) or {}
+    if not bool(_config_get(experience_cfg, "enabled", False)):
+        return False
+    sanitizer_cfg = (
+        _config_get(experience_cfg, "prompt_score_sanitization", {}) or {}
+    )
+    return bool(_config_get(sanitizer_cfg, "hide_selection_metric", False))
+
