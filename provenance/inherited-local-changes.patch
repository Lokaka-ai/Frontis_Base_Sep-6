+def _stable_ast_label(node: ast.AST) -> str:
+    label = type(node).__name__
+    if isinstance(node, ast.alias):
+        return f"alias:{node.name.split('.', 1)[0]}"
+    if isinstance(node, ast.ImportFrom):
+        return f"ImportFrom:{(node.module or '').split('.', 1)[0]}"
+    if isinstance(node, ast.Call):
+        function = node.func
+        if isinstance(function, ast.Attribute):
+            return f"Call:{function.attr}"
+        if isinstance(function, ast.Name) and function.id[:1].isupper():
+            return f"Call:{function.id}"
+        return "Call"
+    if isinstance(node, ast.Attribute):
+        return f"Attribute:{node.attr}"
+    if isinstance(node, ast.Constant):
+        return f"Constant:{type(node.value).__name__}"
+    return label
+
+
+def _wl_raw_features(code: str, iterations: int = 2) -> collections.Counter[str]:
+    try:
+        tree = ast.parse(code)
+    except SyntaxError:
+        return collections.Counter({"syntax_error": 1})
+    nodes = list(ast.walk(tree))
+    index = {id(node): position for position, node in enumerate(nodes)}
+    parents: list[list[int]] = [[] for _ in nodes]
+    children: list[list[int]] = [[] for _ in nodes]
+    for parent in nodes:
+        parent_index = index[id(parent)]
+        for child in ast.iter_child_nodes(parent):
+            child_index = index[id(child)]
+            children[parent_index].append(child_index)
+            parents[child_index].append(parent_index)
+    labels = [_stable_ast_label(node) for node in nodes]
+    features: collections.Counter[str] = collections.Counter(
+        f"0:{label}" for label in labels
+    )
+    for iteration in range(1, iterations + 1):
+        next_labels: list[str] = []
+        for node_index, label in enumerate(labels):
+            payload = json.dumps(
+                [
+                    label,
+                    sorted(labels[value] for value in parents[node_index]),
+                    sorted(labels[value] for value in children[node_index]),
+                ],
+                separators=(",", ":"),
+            )
+            next_labels.append(hashlib.sha256(payload.encode()).hexdigest()[:24])
+        labels = next_labels
+        features.update(f"{iteration}:{label}" for label in labels)
+    return features
+
+
+def _wl_features(codes: list[str]) -> list[dict[str, float]]:
+    raw = [_wl_raw_features(code) for code in codes]
+    document_frequency: collections.Counter[str] = collections.Counter()
+    for vector in raw:
+        document_frequency.update(vector)
+    count = len(raw)
+    result: list[dict[str, float]] = []
+    for vector in raw:
+        weighted = {
+            key: float(value)
+            * (math.log((1.0 + count) / (1.0 + document_frequency[key])) + 1.0)
+            for key, value in vector.items()
+        }
+        norm = math.sqrt(sum(value * value for value in weighted.values()))
+        result.append(
+            {key: value / norm for key, value in weighted.items()} if norm else {}
+        )
+    return result
+
+
+def _cosine_distance(left: dict[str, float], right: dict[str, float]) -> float:
+    if not left or not right:
+        return 1.0 if left != right else 0.0
+    dot = sum(value * right.get(key, 0.0) for key, value in left.items())
+    left_norm = math.sqrt(sum(value * value for value in left.values()))
+    right_norm = math.sqrt(sum(value * value for value in right.values()))
+    if left_norm == 0.0 or right_norm == 0.0:
+        return 1.0 if left_norm != right_norm else 0.0
+    similarity = max(-1.0, min(1.0, dot / (left_norm * right_norm)))
+    return 1.0 - similarity
+
+
+def _minmax(values: list[float], tolerance: float = 1e-12) -> list[float]:
+    if not values:
+        return []
+    low, high = min(values), max(values)
+    if high - low <= tolerance:
+        return [0.0] * len(values)
+    return [(value - low) / (high - low) for value in values]
+
+
 def softmax(values: list[float], temperature: float = 1.0) -> list[float]:
     if not values:
         return []
